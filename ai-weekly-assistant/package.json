{
  "name": "ai-weekly-assistant",
  "version": "0.1.0",
  "description": "AI 周报助手：授权采集本地/云端材料，按目标与标准生成有成果意识的周报",
  "type": "module",
  "bin": {
    "weekly-assistant": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "tsx --test test/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "weekly-report",
    "ai-assistant",
    "git",
    "tencent"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
